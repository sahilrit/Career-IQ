# CareerOS API (FastAPI) — the backend the React frontend consumes.
# Point CAREEROS_DATABASE_URL at Postgres for multi-node production.

FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

WORKDIR /app
COPY . .

# Only the API's dependency subtree (no Streamlit/Playwright/browser),
# so the image is small and the build is fast — important on free tiers.
RUN uv sync --frozen --package careeros-api
RUN rm -rf /var/lib/apt/lists/*

# Overridden in production: CAREEROS_DATABASE_URL, CAREEROS_ADMIN_EMAILS,
# CAREEROS_CORS_ORIGINS, CAREEROS_STRIPE_WEBHOOK_SECRET, SMTP_*.
ENV PORT=8000

EXPOSE 8000

# Call the venv directly (no `uv run`, which would re-sync the root
# project's Streamlit deps and undo the slim install above).
CMD ["sh", "-c", "/app/.venv/bin/uvicorn careeros_api:app --host 0.0.0.0 --port ${PORT}"]
