# CareerOS API (FastAPI) — the backend the React frontend consumes.
# Point CAREEROS_DATABASE_URL at Postgres for multi-node production.

FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

WORKDIR /app
COPY . .

RUN uv sync --all-packages --frozen
RUN rm -rf /var/lib/apt/lists/*

# Overridden in production: CAREEROS_DATABASE_URL, CAREEROS_ADMIN_EMAILS,
# CAREEROS_CORS_ORIGINS, CAREEROS_STRIPE_WEBHOOK_SECRET, SMTP_*.
ENV PORT=8000

EXPOSE 8000

CMD ["sh", "-c", "uv run uvicorn careeros_api:app --host 0.0.0.0 --port ${PORT}"]
